<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Hybrid Framework Suite" verbose="2" parallel="false">
    <listeners>
        <listener class-name="com.Utility.listeners"/>
    </listeners>

    <parameter name="BrowserName" value="${browser}"/>
    <parameter name="environment" value="testpage"/>
    <parameter name="url" value="https://automationintesting.com/selenium/testpage/?#"/>

    <test name="Test Page UI">
        <classes>
            <class name="com.Test.TC_AddEmployee"/>
        </classes>
    </test>
</suite>
