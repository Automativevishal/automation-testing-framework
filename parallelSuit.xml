<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Parallel Suite" parallel="tests" thread-count="3">

    <listeners>
        <listener class-name="com.Utility.listeners"/>
    </listeners>

    <!-- Google -->
    <test name="Google">
        <parameter name="BrowserName" value="chrome"/>
        <parameter name="environment" value="google"/>
        <parameter name="url" value="https://www.google.com/"/>

        <classes>
            <class name="com.Test.GooleSeleniumSearch"/>
        </classes>
    </test>

    <!-- Facebook -->
    <test name="Facebook">
        <parameter name="BrowserName" value="chrome"/>
        <parameter name="environment" value="facebook"/>
        <parameter name="url" value="https://www.facebook.com/login/"/>

        <classes>
            <class name="com.Test.VerifyLoginTest"/>
        </classes>
    </test>

    <!-- OrangeHRM -->
    <test name="OrangeHRM">
        <parameter name="BrowserName" value="chrome"/>
        <parameter name="environment" value="orangehrm"/>
        <parameter name="url" value="https://opensource-demo.orangehrmlive.com/web/index.php/auth/login"/>

        <classes>
            <class name="com.Test.TC_AddEmployee"/>
        </classes>
    </test>

</suite>