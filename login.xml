<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Facebook Login Suite" verbose="2" parallel="false">
    <listeners>
        <listener class-name="com.Utility.listeners"/>
    </listeners>

    <test name="Facebook Login Chrome">
        <parameter name="BrowserName" value="chrome"/>
        <parameter name="environment" value="facebook"/>
        <parameter name="url" value="https://www.facebook.com/login/"/>
        <classes>
            <class name="com.Test.VerifyLoginTest"/>
        </classes>
    </test>
</suite>
